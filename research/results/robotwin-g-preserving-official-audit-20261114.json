  "normalization": {
    "image": "Mean over B*1*256*768 DINO feature coordinates. SmoothL1 beta0.1 for original baseline; MSE for candidate. Image target is frozen future DINO feature from decoder view.",
    "state": "Sum squared errors over valid robot coordinates / total valid-coordinate count; local all-robot B4 gives denominator4*16=64, not4*32. No per-group variance weighting.",
    "kl": "beta * mean over examples of 0.5*sum over32 latent coordinates(mu^2+exp(logvar)-1-logvar). Same sum/mean convention in clean official source.",
    "robot_subset": "g loss is averaged over robot subset, image over all samples. All-human batch uses zero dummy state loss. Mixed human/robot official data recipe therefore changes exposure of g but not direct robot fraction scaling in mixed batches."
  },
  "routes": {
    "vision_backbone": "DINO frozen eval, encode @no_grad and returns detach; identical clean/local.",
    "encoder_vae": "No detach from encoder nodes through FP32 VAE sample into visual decoder or g. The two heads receive same quantized sample.",
    "state_inputs": "g concatenates projected sampled z with projected current state; predicts normalized-state future-minus-current delta, not absolute future state. Both clean official collate and local use this target.",
    "kl_sibling": "KL reaches mu/logvar/encoder directly. dKL/dsampled_z is None because sampled z is a sibling output, not an ancestor of KL.",
    "state_scale_patch": "Only computation-changing source patch is g output 2*tanh instead of tanh, routed through two constructor fields; visual encoder/VAE/visualdecoder source unchanged. This changes g derivative and accessible delta range."
  },
  "optimizer_and_clip": {
